{
  "name": "SeibiYoteiReorder",
  "version": "1.0.0",
  "description": "整備予定担当者順序変更ツール",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test-db": "node test.js",
    "build": "electron-builder"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "dotenv": "^16.6.1",
    "oracledb": "^6.10.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "electron": "^23.1.3",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.internal.seibi-yotei-reorder",
    "productName": "整備予定担当者順序変更",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "src/**/*",
      "node_modules/**/*"
    ]
  }
}
